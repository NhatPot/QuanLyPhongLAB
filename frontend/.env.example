# URL công khai dùng trong trình duyệt. Giữ /api để Next.js chuyển tiếp đến backend.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_DATA_MODE=sql

# Backend Express hiện tại, chỉ được đọc ở phía Next.js server.
BACKEND_URL=http://localhost:5000

# Set NEXT_PUBLIC_DATA_MODE=mock and restart Next.js to use the built-in fixtures.
