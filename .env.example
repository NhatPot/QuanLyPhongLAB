# Cấu hình ứng dụng Next.js Fullstack
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_DATA_MODE=sql

# Cấu hình Cơ sở dữ liệu SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
DB_NAME=ItLabManagerDb
DB_ENCRYPT=false

# Bảo mật JWT Tokens
JWT_SECRET=super-secret-jwt-key
REFRESH_TOKEN_SECRET=super-secret-refresh-key
JWT_EXPIRATION=15m
