# Cấu hình ứng dụng Next.js Fullstack
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_DATA_MODE=sql

# Cấu hình Cơ sở dữ liệu SQL Server
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_ENCRYPT=true

# Bảo mật JWT Tokens
JWT_SECRET=
REFRESH_TOKEN_SECRET=
# Access token dùng thời hạn cố định 15 phút.

# URL công khai chính xác của web. Bắt buộc đặt đúng khi triển khai sau reverse proxy.
APP_ORIGIN=http://localhost:3000
# Có thể đặt khóa riêng; nếu bỏ trống dùng JWT_SECRET để ký CSRF token.
CSRF_SECRET=
# Chỉ bật khi proxy tin cậy ghi đè X-Forwarded-For và chặn truy cập trực tiếp backend.
TRUST_PROXY=false

# Google/OTP/SMTP do FIT LHU SSO quản lý; tắt các luồng trực tiếp tại Lab.
SELF_REGISTRATION_ENABLED=false
AUTH_EMAIL_ENABLED=false
GOOGLE_AUTH_ENABLED=false
# Cần schema 031 trên DB ứng dụng trước khi bật SSO.
# FIT LHU SSO: Authorization Code + PKCE. Secret/flow key chỉ ở server.
FIT_SSO_ENABLED=false
FIT_SSO_ISSUER=https://auth.fitlhu.com
FIT_SSO_CLIENT_ID=
FIT_SSO_CLIENT_SECRET=
# Khóa ngẫu nhiên riêng 64 ký tự hex, ổn định và dùng chung giữa các replica.
FIT_SSO_FLOW_KEY=
FIT_SSO_ALLOWED_ORIGINS=http://localhost:3000,https://lab.fitlhu.com
STUDENT_EMAIL_DOMAINS=lachong.edu.vn
TEACHER_EMAIL_DOMAINS=lhu.edu.vn
NODE_ENV=development
