# Cấu hình ứng dụng Next.js Fullstack
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_DATA_MODE=sql

# Cấu hình Cơ sở dữ liệu SQL Server
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_ENCRYPT=true

# Bảo mật JWT Tokens
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRATION=15m

NODE_ENV=development 
